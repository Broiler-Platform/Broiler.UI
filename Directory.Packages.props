<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Dependency versions are independent of the version being published for UI.
       The sample hosts pin their platform backends separately from the versions the
       runtime libraries build against. -->
  <PropertyGroup>
    <BroilerGraphicsPackageVersion>0.1.0-preview.7</BroilerGraphicsPackageVersion>
    <BroilerInputPackageVersion>0.1.0-preview.5</BroilerInputPackageVersion>
    <BroilerDocumentsPackageVersion>0.1.0-preview.21</BroilerDocumentsPackageVersion>
    <BroilerSampleGraphicsPackageVersion>0.1.0-preview.7</BroilerSampleGraphicsPackageVersion>
    <BroilerSampleInputPackageVersion>0.1.0-preview.5</BroilerSampleInputPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Broiler component packages used by the runtime libraries -->
    <PackageVersion Include="Broiler.Documents.FormatCodes" Version="$(BroilerDocumentsPackageVersion)" />
    <PackageVersion Include="Broiler.Documents.Model" Version="$(BroilerDocumentsPackageVersion)" />
    <PackageVersion Include="Broiler.Documents.Rtf" Version="$(BroilerDocumentsPackageVersion)" />
    <PackageVersion Include="Broiler.Graphics" Version="$(BroilerGraphicsPackageVersion)" />
    <PackageVersion Include="Broiler.Input" Version="$(BroilerInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard" Version="$(BroilerInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Mouse" Version="$(BroilerInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Pen" Version="$(BroilerInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Text" Version="$(BroilerInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Touch" Version="$(BroilerInputPackageVersion)" />

    <!-- Platform backends used only by the sample hosts -->
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="$(BroilerSampleGraphicsPackageVersion)" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="$(BroilerSampleGraphicsPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Camera.Windows" Version="$(BroilerSampleInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="$(BroilerSampleInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Microphone.Windows" Version="$(BroilerSampleInputPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="$(BroilerSampleInputPackageVersion)" />

    <!-- Test dependencies (referenced for every test project by src/tests/Directory.Build.props) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
