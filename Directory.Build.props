<Project>

  <!-- Chain to a parent Directory.Build.props when one exists (in-tree build).
       Skipped for standalone / submodule builds. The path is captured in a
       property first so the inner quotes don't collide with the Condition. -->
  <PropertyGroup>
    <BroilerParentBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</BroilerParentBuildProps>
  </PropertyGroup>
  <Import Project="$(BroilerParentBuildProps)" Condition="'$(BroilerParentBuildProps)' != ''" />

  <!-- Where the Broiler.Input projects live. It defaults to the vendored
       submodule so this repo builds on its own; a consumer with its own copy
       sets it in the Directory.Build.props above, which is imported first, and
       then one assembly of each name is built instead of several. -->
  <PropertyGroup Condition="'$(BroilerInputRoot)' == ''">
    <BroilerInputRoot>$(MSBuildThisFileDirectory)Broiler.Input</BroilerInputRoot>
  </PropertyGroup>

  <!-- Where the Broiler.Graphics projects live. It defaults to the vendored
       submodule so this repo builds on its own; a consumer with its own copy
       sets it in the Directory.Build.props above, which is imported first, and
       then one assembly of each name is built instead of several. -->
  <PropertyGroup Condition="'$(BroilerGraphicsRoot)' == ''">
    <BroilerGraphicsRoot>$(MSBuildThisFileDirectory)Broiler.Graphics</BroilerGraphicsRoot>
  </PropertyGroup>

  <!-- Where the Broiler.Documents projects live. It defaults to the vendored
       submodule, so this repo builds on its own. A consumer that has its own
       copy of Broiler.Documents sets this in the Directory.Build.props above,
       which is imported first, and then its build compiles one
       Broiler.Documents.Model rather than two with the same assembly name. -->
  <PropertyGroup Condition="'$(BroilerDocumentsRoot)' == ''">
    <BroilerDocumentsRoot>$(MSBuildThisFileDirectory)Broiler.Documents</BroilerDocumentsRoot>
  </PropertyGroup>

  <!-- Broiler NuGet packaging metadata (vendored; do not edit by hand). -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Broiler.Packaging.props" />

  <!-- The solution declares six configurations. Debug/Release build the
       platform-neutral set; the -Linux and -Windows variants add the sample
       hosts for that platform and select the matching runtime identifier.
       MSBuild only understands Debug and Release on its own, so the compound
       names are decomposed here into a base configuration and a target OS. -->
  <PropertyGroup>
    <BroilerBaseConfiguration Condition="'$(Configuration)' == 'Debug-Linux' Or '$(Configuration)' == 'Debug-Windows'">Debug</BroilerBaseConfiguration>
    <BroilerBaseConfiguration Condition="'$(Configuration)' == 'Release-Linux' Or '$(Configuration)' == 'Release-Windows'">Release</BroilerBaseConfiguration>
    <BroilerTargetOperatingSystem Condition="'$(Configuration)' == 'Debug-Linux' Or '$(Configuration)' == 'Release-Linux'">Linux</BroilerTargetOperatingSystem>
    <BroilerTargetOperatingSystem Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">Windows</BroilerTargetOperatingSystem>

    <DebugSymbols Condition="'$(BroilerBaseConfiguration)' == 'Debug'">true</DebugSymbols>
    <DebugType Condition="'$(BroilerBaseConfiguration)' == 'Debug'">portable</DebugType>
    <Optimize Condition="'$(BroilerBaseConfiguration)' == 'Debug'">false</Optimize>
    <DefineConstants Condition="'$(BroilerBaseConfiguration)' == 'Debug'">$(DefineConstants);DEBUG</DefineConstants>
    <DebugType Condition="'$(BroilerBaseConfiguration)' == 'Release'">portable</DebugType>
    <Optimize Condition="'$(BroilerBaseConfiguration)' == 'Release'">true</Optimize>
    <DefineConstants Condition="'$(BroilerBaseConfiguration)' == 'Release'">$(DefineConstants);RELEASE</DefineConstants>

    <DefineConstants Condition="'$(BroilerTargetOperatingSystem)' == 'Linux'">$(DefineConstants);LINUX</DefineConstants>
    <DefineConstants Condition="'$(BroilerTargetOperatingSystem)' == 'Windows'">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Component-owned overrides. These are evaluated AFTER the packaging import
       above and therefore win, which is the extension point the vendored file
       documents. The shared default points at a GitHub profile; a published
       package should link to the component's own repository instead. -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.UI</PackageProjectUrl>
    <PackageTags>broiler;ui;controls;widgets;retained-mode</PackageTags>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

</Project>
