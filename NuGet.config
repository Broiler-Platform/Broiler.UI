<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.UI.

    <clear /> drops whatever sources the machine happens to have configured, so a
    restore resolves the same way on every developer box and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="broiler-github" value="https://nuget.pkg.github.com/Broiler-Platform/index.json" />
  </packageSources>

  <!--
    Source mapping keeps the two feeds in their lanes. Broiler.* may come from the
    Broiler-Platform GitHub Packages feed or from nuget.org once published; everything
    else resolves from nuget.org only.

    The more specific Broiler.* mapping selects GitHub Packages for Broiler
    dependencies. That feed requires authentication even for public packages.
    CI supplies GITHUB_TOKEN; local builds need read:packages credentials or
    a separate nuget.org-only config when the dependencies are available there.

    Credentials are deliberately absent. Never commit a token here; see the README
    section "Consuming Broiler packages from GitHub Packages".
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- Also listed here so Broiler.* resolves from nuget.org once published there:
           Broiler.Graphics 0.1.0-preview.5 and Broiler.Documents 0.1.0-preview.16 are
           on nuget.org but not on the GitHub feed. A pattern mapped to one source only
           would make that source the sole candidate. -->
      <package pattern="Broiler.*" />
    </packageSource>
    <packageSource key="broiler-github">
      <package pattern="Broiler.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
