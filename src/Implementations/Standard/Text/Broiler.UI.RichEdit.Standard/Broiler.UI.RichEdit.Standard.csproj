<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Broiler.UI.RichEdit.Standard</RootNamespace>
    <AssemblyName>Broiler.UI.RichEdit.Standard</AssemblyName>
    <PackageId>Broiler.UI.RichEdit.Standard</PackageId>
    <Description>Standard platform-neutral Broiler rich-edit implementation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Graphics" Version="$(BroilerGraphicsPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Abstractions\Text\Broiler.UI.RichEdit\Broiler.UI.RichEdit.csproj" />
    <ProjectReference Include="..\..\..\..\Foundation\Broiler.UI.Standard\Broiler.UI.Standard.csproj" />
  </ItemGroup>

  <!-- The layout, image cache, painter, and scroll collaborators are internal;
       their tests exercise them directly rather than only through the control. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.UI.RichEdit.Standard.Tests" />
  </ItemGroup>

</Project>
