<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Broiler.UI</RootNamespace>
    <AssemblyName>Broiler.UI</AssemblyName>
    <PackageId>Broiler.UI</PackageId>
    <Description>Platform-neutral Broiler retained-mode UI root contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Graphics" Version="0.1.0-preview.2" />
    <PackageReference Include="Broiler.Input" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.Input.Keyboard" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.Input.Mouse" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.Input.Pen" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.Input.Text" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.Input.Touch" Version="0.1.0-preview.4" />
  </ItemGroup>

</Project>
